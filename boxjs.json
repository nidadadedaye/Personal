{
  "id": "personal.scripts",
  "name": "Personal 脚本设置",
  "author": "@nidadadedaye",
  "repo": "https://github.com/nidadadedaye/Personal",
  "apps": [
    {
      "id": "szgh_daily",
      "name": "深i工 每日任务",
      "keys": [
        "szgh_card",
        "szgh_token_extra",
        "szgh_token_captured"
      ],
      "settings": [
        {
          "id": "szgh_card",
          "name": "阵地打卡会员卡号",
          "val": "",
          "type": "textarea",
          "autoGrow": true,
          "rows": 2,
          "desc": "格式：备注:卡号，多个用 & 分隔",
          "placeholder": "本机自动抓取1:1234567890"
        },
        {
          "id": "szgh_token_extra",
          "name": "额外账号 token",
          "val": "",
          "type": "textarea",
          "autoGrow": true,
          "rows": 3,
          "desc": "格式：token@备注，多个用 & 或换行分隔",
          "placeholder": "abcdef0123456789@老婆"
        },
        {
          "id": "szgh_token_captured",
          "name": "自动抓取数据",
          "val": "",
          "type": "textarea",
          "autoGrow": true,
          "rows": 2,
          "desc": "仅供查看，请勿手动修改；如需清空重置，删除内容后保存即可"
        }
      ]
    },
    {
      "id": "szgh_redeem",
      "name": "深i工 0元专区抢兑",
      "keys": [
        "szgh_phone",
        "szgh_target",
        "szgh_redeem_extra",
        "szgh_redeem_sessions"
      ],
      "settings": [
        {
          "id": "szgh_phone",
          "name": "手机号",
          "val": "",
          "type": "text",
          "desc": "11 位数字，仅虚拟商品下单需要",
          "placeholder": "13800138000"
        },
        {
          "id": "szgh_target",
          "name": "目标商品 SKU",
          "val": "",
          "type": "text",
          "desc": "纯数字，先留空跑一次看日志再回填",
          "placeholder": "1366073650545438720"
        },
        {
          "id": "szgh_redeem_extra",
          "name": "额外账号",
          "val": "",
          "type": "textarea",
          "autoGrow": true,
          "rows": 3,
          "desc": "格式：JSESSIONID#csrf-token#手机号@备注，多个用 & 或换行分隔",
          "placeholder": "JSESSIONIDxxx#csrfxxx#13900139000@老婆"
        },
        {
