#!name=飞蚁回收
#!desc=飞蚁回收小程序日常任务，登录凭据自动抓取，配置见 boxjs.json
#!category=自用模块
#!author=Personal
#!homepage=https://github.com/nidadadedaye/Personal

[Script]
feiyi-cron = type=cron,cronexp="45 6,7 * * *",timeout=300,wake-system=1,script-update-interval=3600,script-path=https://raw.githubusercontent.com/nidadadedaye/Personal/main/scripts/feiyi.js
feiyi-capture = type=http-response,pattern=^https:\/\/openapp\.fmy90\.com\/auth\/wx\/login,requires-body=true,script-update-interval=3600,script-path=https://raw.githubusercontent.com/nidadadedaye/Personal/main/scripts/feiyi.js

[MITM]
hostname = %APPEND% openapp.fmy90.com
