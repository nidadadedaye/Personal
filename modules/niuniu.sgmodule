#!name=牛牛短剧
#!desc=牛牛短剧小程序日常任务，token 自动抓取，配置见 boxjs.json
#!category=自用模块
#!author=Personal
#!homepage=https://github.com/nidadadedaye/Personal

[Script]
niuniu-cron = type=cron,cronexp="0 8,12,18,21 * * *",timeout=600,wake-system=1,script-update-interval=3600,script-path=https://raw.githubusercontent.com/nidadadedaye/Personal/main/scripts/niuniu.js
niuniu-capture = type=http-request,pattern=^https?:\/\/api\.tianjinzhitongdaohe\.com\/sqx_fast\/,requires-body=false,script-update-interval=3600,script-path=https://raw.githubusercontent.com/nidadadedaye/Personal/main/scripts/niuniu.js

[MITM]
hostname = %APPEND% api.tianjinzhitongdaohe.com
