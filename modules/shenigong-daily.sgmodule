#!name = 深i工 每日任务
#!desc = 深圳工会「深i工」小程序每日积分任务：登录、频道浏览、内容任务、阵地打卡、答题抽奖。由 shenigong_daily.py 移植而来，逆向细节（AES 密钥、任务埋点码）已在脚本内公开。
#!category = Utility
#!author = Personal
#!homepage = https://github.com/nidadadedaye/Personal

#!arguments = szgh_card=&szgh_token=
#!arguments-desc = szgh_token（必填）：登录 token，来源为小程序抓包请求头 token 字段（服务端会话凭据，过期需重抓，表现为返回 code=401 或 msg 含"登录"）。多账号用 & 或换行分隔，格式 token@备注；备注不要含英文逗号。 | szgh_card（选填，仅"阵地打卡"任务需要）：会员卡号，格式 备注:卡号，多个用 & 分隔；备注需与 szgh_token 的 @备注 完全一致，否则该账号会跳过打卡。

[Script]
shenigong-daily = type=cron,cronexp="17 8 * * *",timeout=180,script-path=https://raw.githubusercontent.com/nidadadedaye/Personal/main/scripts/shenigong_daily.js,argument=szgh_card={{{szgh_card}}}&szgh_token={{{szgh_token}}}
