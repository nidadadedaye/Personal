#!name=深i工 每日任务
#!desc=深圳工会「深i工」小程序每日积分任务：登录、频道浏览、内容任务、阵地打卡、答题抽奖。由 shenigong_daily.py 移植而来，逆向细节（AES 密钥、任务埋点码）已在脚本内公开。安装后正常打开一次深i工小程序即可自动抓取 token，无需手动抓包配置。
#!category=Utility
#!author=Personal
#!homepage=https://github.com/nidadadedaye/Personal
#!arguments=szgh_card=&szgh_token=
#!arguments-desc=szgh_token（选填，用于追加"自动抓取"以外的账号）：登录 token，多账号用 & 或换行分隔，格式 token@备注；备注不要含英文逗号。主账号不用填这个——正常使用深i工小程序时脚本会自动从流量里抓 token 并保存，token 过期也会在下次打开小程序时自动刷新。 | szgh_card（选填，仅"阵地打卡"任务需要）：会员卡号，格式 备注:卡号，多个用 & 分隔；自动抓取的账号备注固定为"本机自动抓取"。

[Script]
shenigong-daily-cron = type=cron,cronexp="17 8 * * *",timeout=180,script-path=https://raw.githubusercontent.com/nidadadedaye/Personal/main/scripts/shenigong_daily.js,argument=szgh_card={{{szgh_card}}}&szgh_token={{{szgh_token}}}
shenigong-daily-capture = type=http-request,pattern=^https:\/\/lsapp\.szzgh\.org:99\/api\/,requires-body=false,script-path=https://raw.githubusercontent.com/nidadadedaye/Personal/main/scripts/shenigong_daily.js

[MITM]
hostname = %APPEND% lsapp.szzgh.org
