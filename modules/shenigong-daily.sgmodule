#!name=深i工 每日任务
#!desc=深圳工会「深i工」小程序每日积分任务：登录、频道浏览、内容任务、阵地打卡、答题抽奖。由 shenigong_daily.py 移植而来，逆向细节（AES 密钥、任务埋点码）已在脚本内公开。安装后正常打开一次深i工小程序即可自动抓取 token，无需手动抓包配置。阵地打卡会员卡号/额外账号配合 BoxJs 填写，订阅本仓库根目录的 boxjs.json。
#!category=Utility
#!author=Personal
#!homepage=https://github.com/nidadadedaye/Personal

[Script]
shenigong-daily-cron = type=cron,cronexp="17 8 * * *",timeout=600,wake-system=1,script-path=https://raw.githubusercontent.com/nidadadedaye/Personal/main/scripts/shenigong_daily.js
shenigong-daily-capture = type=http-request,pattern=^https?:\/\/lsapp\.szzgh\.org(:\d+)?\/,requires-body=false,debug=true,script-path=https://raw.githubusercontent.com/nidadadedaye/Personal/main/scripts/shenigong_daily.js

[MITM]
hostname = %APPEND% lsapp.szzgh.org:99
