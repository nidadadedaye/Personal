#!name=深i工 每日任务
#!desc=深圳工会「深i工」小程序每日积分任务，token 自动抓取，配置见 boxjs.json
#!category=自用模块
#!author=Personal
#!homepage=https://github.com/nidadadedaye/Personal

[Script]
shengong-daily-cron = type=cron,cronexp="17 8 * * *",timeout=600,wake-system=1,script-update-interval=3600,script-path=https://raw.githubusercontent.com/nidadadedaye/Personal/main/scripts/shengong_daily.js
shengong-daily-capture = type=http-request,pattern=^https?:\/\/lsapp\.szzgh\.org(:\d+)?\/,requires-body=false,script-update-interval=3600,script-path=https://raw.githubusercontent.com/nidadadedaye/Personal/main/scripts/shengong_daily.js

[MITM]
hostname = %APPEND% lsapp.szzgh.org:99
