#!name=深i工 0元专区抢兑
#!desc=深圳工会「深i工」小程序 0 元专区抢兑：拉取当期商品、按 SKU 匹配、临近开抢时间点并发下单直到成功/排队/失败。由 shenigong_redeem.py 移植而来，逆向出的签名算法已在脚本内公开。安装后正常打开一次深i工小程序（进入过商城页面）即可自动抓取登录凭据。手机号/目标 SKU/额外账号配合 BoxJs 填写，订阅本仓库根目录的 boxjs.json。
#!category=Utility
#!author=Personal
#!homepage=https://github.com/nidadadedaye/Personal
# cronexp 需要按你要抢的商品实际开抢时间改成"提前一分钟左右"，例如某天 10:00 开抢就配 "55 9 * * *"；
# 脚本内部会用 setTimeout 精确等到毫秒级开抢点再下单，提前触发只是为了留出预热和网络延迟余量。

[Script]
shenigong-redeem-cron = type=cron,cronexp="55 9 * * *",timeout=400,wake-system=1,script-path=https://raw.githubusercontent.com/nidadadedaye/Personal/main/scripts/shenigong_redeem.js
shenigong-redeem-capture = type=http-request,pattern=^https?:\/\/miniapp-gig\.szzgh\.org\/,requires-body=false,debug=true,script-path=https://raw.githubusercontent.com/nidadadedaye/Personal/main/scripts/shenigong_redeem.js

[MITM]
hostname = %APPEND% miniapp-gig.szzgh.org
