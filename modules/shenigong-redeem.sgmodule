#!name = 深i工 0元专区抢兑
#!desc = 深圳工会「深i工」小程序 0 元专区抢兑：拉取当期商品、按 SKU 匹配、临近开抢时间点并发下单直到成功/排队/失败。由 shenigong_redeem.py 移植而来，逆向出的签名算法已在脚本内公开。
#!category = Utility
#!author = Personal
#!homepage = https://github.com/nidadadedaye/Personal

#!arguments = szgh_target=&szgh_redeem=
#!arguments-desc = szgh_target（必填，可先留空跑一次看日志再回填）：要抢兑的商品 SKU，纯数字，来源为脚本运行日志里打印的商品清单（caseId/skuId）。 | szgh_redeem（必填）：JSESSIONID#csrf-token#手机号@备注，来源为商城 miniapp-gig.szzgh.org 请求头（不是「每日任务」模块用的 lsapp token）。多账号用 & 或换行分隔，备注不要含英文逗号。

# cronexp 需要按你要抢的商品实际开抢时间改成"提前一分钟左右"，例如某天 10:00 开抢就配 "55 9 * * *"；
# 脚本内部会用 setTimeout 精确等到毫秒级开抢点再下单，提前触发只是为了留出预热和网络延迟余量。
[Script]
shenigong-redeem = type=cron,cronexp="55 9 * * *",timeout=320,script-path=https://raw.githubusercontent.com/nidadadedaye/Personal/main/scripts/shenigong_redeem.js,argument=szgh_target={{{szgh_target}}}&szgh_redeem={{{szgh_redeem}}}
